                        </Array>
                        <mxPoint x="820" y="149" as="sourcePoint"/>
                        <mxPoint x="1252" y="134" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_ec_el" value="&lt;font style=&quot;font-size:10px&quot;&gt;elevation [rad]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#666666;fontColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" source="E" target="C" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1630" y="94"/>
                            <mxPoint x="792" y="94"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_eb_azel" value="&lt;font style=&quot;font-size:10px&quot;&gt;azimuth, elevation (SysState, previous step)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#666666;fontColor=#666666;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" source="E" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1552" y="114"/>
                            <mxPoint x="455" y="114"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_cf_phase" value="&lt;font style=&quot;font-size:10px&quot;&gt;phase&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;align=right;verticalAlign=middle;labelBackgroundColor=#ffffff;" parent="1" source="C" target="F" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_gs_psi" value="&lt;font style=&quot;font-size:11px&quot;&gt;ψ&#39;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;align=right;verticalAlign=middle;labelBackgroundColor=#ffffff;" parent="1" source="G" target="sigma" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_eg_hcv" value="&lt;font style=&quot;font-size:10px&quot;&gt;heading, course, v_kite (SysState)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#666666;fontColor=#666666;exitX=0.203;exitY=0.987;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;exitPerimeter=0;" parent="1" source="E" target="G" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1553" y="294"/>
                            <mxPoint x="1550" y="294"/>
                            <mxPoint x="1550" y="364"/>
                            <mxPoint x="1206" y="364"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_fe_depower" value="&lt;font style=&quot;font-size:11px&quot;&gt;rel_depower&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;" parent="1" source="F" target="E" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="764" y="624"/>
                            <mxPoint x="1440" y="624"/>
                            <mxPoint x="1440" y="262"/>
                            <mxPoint x="1500" y="262"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_ew_force" value="&lt;font style=&quot;font-size:10px&quot;&gt;tether force / winch mode&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;dashed=1;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;" parent="1" source="E" target="W" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="legend1" value="&lt;b&gt;Signal conventions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Bearing:&lt;/b&gt; 0 = towards zenith, positive toward larger azimuth — chi_set is directly comparable to SysState.heading, same zero and sign.&lt;br&gt;&lt;b&gt;rel_steering:&lt;/b&gt; A positive steering input causes a positive heading rate.&lt;br&gt;&lt;b&gt;err&lt;/b&gt; = wrap2pi(ψ&#39; − chi_cmd), wrapped here because DiscretePIDs does not wrap.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="644" width="680" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="legend2" value="&lt;b&gt;Cascade, gain scheduling &amp;amp; engagement&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Guidance (B) and steering (C/Σ/D) run once per timestep (1/sample_freq) and together form the flight controller proper: geometry in, rel_steering out. The reference path (A) is built once before flight, or at most walked slowly during it.&lt;br&gt;The PID gain is scheduled twice: by &lt;b&gt;apparent wind&lt;/b&gt; (K ∝ v_app_ref/v_app, cancelling the plant&#39;s ψ̇ ≈ c1·v_a·u_s) and by &lt;b&gt;phase&lt;/b&gt; (entry_gain = 25 % below phase 3, full gain from phase 3).&lt;br&gt;&lt;b&gt;Engagement is bumpless:&lt;/b&gt; the PID is stepped with a zero error and its output discarded during park (phase 0), so phase 1&#39;s first command is not a step.&lt;br&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="770" y="644" width="690" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>