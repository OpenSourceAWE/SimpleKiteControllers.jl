                <mxCell id="e_de" value="&lt;font style=&quot;font-size:11px&quot;&gt;rel_steering&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" parent="1" source="D" target="E" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
