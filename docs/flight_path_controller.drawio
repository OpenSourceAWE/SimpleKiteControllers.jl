                <mxCell id="e_ed_vapp" value="&lt;font style=&quot;font-size:10px&quot;&gt;v_app [m/s]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#6c8ebf;fontColor=#6c8ebf;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.833;entryY=-0.002;entryDx=0;entryDy=0;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;entryPerimeter=0;" parent="1" source="E" target="D" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1708" y="64"/>
