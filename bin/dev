#!/bin/bash
# Copyright (c) 2026 Uwe Fechner
# SPDX-License-Identifier: MIT
#
# Point examples/Project.toml at a local V3Kite checkout (default: ../V3Kite,
# a sibling of this repository) and re-resolve. A git-rev source makes init()
# cost ~34 s instead of ~2 s; see docs/sysimage_notes.md. Undo with bin/free
# before pushing.
#
# The public url/rev line is commented out rather than overwritten, so bin/free
# restores the pinned rev verbatim instead of reconstructing it from a default.
#
# The closing resolve/instantiate runs under bin/kps-image-<major>.so if that
# file exists, same as bin/run_julia.
#
# Usage: bin/dev [path-to-checkout]
#        bin/dev --status          report the current source, change nothing
set -euo pipefail

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

PROJECT=examples/Project.toml
[[ -f $PROJECT ]] || { echo "No $PROJECT" >&2; exit 1; }

# The live [sources] entry, skipping both the commented-out memo and the
# identically named [deps] line.
active_source() {
    awk '
        /^\[/ { in_sources = ($0 ~ /^\[sources\]/) }
        in_sources && /^V3Kite[[:space:]]*=/ { print; exit }
    ' "$PROJECT"
}

status() {
    local line dir
    line=$(active_source)
    if [[ -z $line ]]; then
        echo "V3Kite: no entry in [sources] of $PROJECT"
    elif [[ $line =~ path[[:space:]]*= ]]; then
        dir=$(sed -E 's|.*path[[:space:]]*=[[:space:]]*"([^"]*)".*|\1|' <<<"$line")
        [[ $dir == /* ]] || dir="examples/$dir"
        echo "V3Kite -> $(realpath -m "$dir")" \
             "($(git -C "$dir" describe --always --dirty 2>/dev/null || echo 'not a git checkout'))"
        echo "         local checkout - not committable, run bin/free before pushing"
    else
        echo "V3Kite -> ${line#*= }"
    fi
}

if [[ ${1:-} == --status ]]; then
    status
    exit 0
fi

CHECKOUT=${1:-../V3Kite}

if [[ ! -f "$CHECKOUT/Project.toml" ]]; then
    echo "No Julia project at $CHECKOUT" >&2
    exit 1
fi
if ! grep -q '^name = "V3Kite"' "$CHECKOUT/Project.toml"; then
    echo "$CHECKOUT is not V3Kite" >&2
    exit 1
fi
if [[ -z $(active_source) ]]; then
    echo "No V3Kite entry in [sources] of $PROJECT" >&2
    exit 1
fi

# Stored relative to examples/, so the entry survives a move of the repo.
REL=$(realpath --relative-to=examples "$CHECKOUT")

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
awk -v newline="V3Kite = {path = \"$REL\"}" '
    /^\[/ { in_sources = ($0 ~ /^\[sources\]/) }
    in_sources && /^#[[:space:]]*V3Kite[[:space:]]*=/ { memo = 1 }
    in_sources && /^V3Kite[[:space:]]*=/ {
        if (!memo && $0 !~ /path[[:space:]]*=/) print "# " $0
        print newline
        next
    }
    { print }
' "$PROJECT" > "$TMP"
cp "$TMP" "$PROJECT"

status

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi
SOFILE="bin/kps-image-${julia_major}.so"
JULIA_IMAGE_FLAG=()
[[ -f $SOFILE ]] && JULIA_IMAGE_FLAG=(-J "$SOFILE")

julia --project=examples "${JULIA_IMAGE_FLAG[@]}" -e 'using Pkg; Pkg.resolve(); Pkg.instantiate()'
