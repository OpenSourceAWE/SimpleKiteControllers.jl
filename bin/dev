#!/bin/bash
# Copyright (c) 2026 Uwe Fechner
# SPDX-License-Identifier: MIT
#
# Point examples/Project.toml at a local V3Kite checkout (default: ../V3Kite,
# a sibling of this repository) and re-resolve. A git-rev source makes init()
# cost ~34 s instead of ~2 s; see docs/sysimage_notes.md. Undo with bin/free
# before pushing.
#
# Usage: bin/dev [path-to-checkout]
set -e

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

CHECKOUT=${1:-../V3Kite}

if [[ ! -f "$CHECKOUT/Project.toml" ]]; then
    echo "No Julia project at $CHECKOUT" >&2
    exit 1
fi
if ! grep -q '^name = "V3Kite"' "$CHECKOUT/Project.toml"; then
    echo "$CHECKOUT is not V3Kite" >&2
    exit 1
fi
if ! grep -q "^V3Kite = {" examples/Project.toml; then
    echo "No V3Kite entry in [sources] of examples/Project.toml" >&2
    exit 1
fi

# Stored relative to examples/, so the entry survives a move of the repo.
REL=$(realpath --relative-to=examples "$CHECKOUT")
sed -i -E "s|^V3Kite = \{.*\}|V3Kite = {path = \"$REL\"}|" examples/Project.toml
echo "V3Kite -> $(realpath "$CHECKOUT") ($(git -C "$CHECKOUT" describe --always --dirty 2>/dev/null || echo 'not a git checkout'))"

julia --project=examples -e 'using Pkg; Pkg.resolve(); Pkg.instantiate()'
