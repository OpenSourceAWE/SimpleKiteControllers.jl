#!/bin/bash
# Copyright (c) 2026 Uwe Fechner
# SPDX-License-Identifier: MIT
#
# Put examples/Project.toml back on the public V3Kite and re-resolve. This is
# the committable state; the price is a ~34 s init(), see docs/sysimage_notes.md.
# Undo with bin/dev.
#
# The url/rev line bin/dev commented out is restored verbatim, so the pinned rev
# survives the round trip. DEFAULT_REV applies only when that memo is missing —
# a hand-edited file, or a checkout switched by a bin/dev predating it.
#
# The closing resolve/instantiate runs under bin/kps-image-<major>.so if that
# file exists, same as bin/run_julia.
#
# Usage: bin/free [rev]           force a rev instead of restoring the memo
set -euo pipefail

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

PROJECT=examples/Project.toml
[[ -f $PROJECT ]] || { echo "No $PROJECT" >&2; exit 1; }

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi
SOFILE="bin/kps-image-${julia_major}.so"
JULIA_IMAGE_FLAG=()
[[ -f $SOFILE ]] && JULIA_IMAGE_FLAG=(-J "$SOFILE")

URL="https://github.com/OpenSourceAWE/V3Kite.jl"
DEFAULT_REV=v1.0.2

memo=$(awk '
    /^\[/ { in_sources = ($0 ~ /^\[sources\]/) }
    in_sources && /^#[[:space:]]*V3Kite[[:space:]]*=/ { sub(/^#[[:space:]]*/, ""); print; exit }
' "$PROJECT")

active=$(awk '
    /^\[/ { in_sources = ($0 ~ /^\[sources\]/) }
    in_sources && /^V3Kite[[:space:]]*=/ { print; exit }
' "$PROJECT")

if [[ -z $active ]]; then
    echo "No V3Kite entry in [sources] of $PROJECT" >&2
    exit 1
fi

if [[ -n ${1:-} ]]; then
    newline="V3Kite = {url = \"$URL\", rev = \"$1\"}"
elif [[ -n $memo ]]; then
    newline=$memo
else
    newline="V3Kite = {url = \"$URL\", rev = \"$DEFAULT_REV\"}"
    echo "No commented-out source to restore, falling back to rev $DEFAULT_REV" >&2
fi

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
awk -v newline="$newline" '
    /^\[/ { in_sources = ($0 ~ /^\[sources\]/) }
    in_sources && /^#[[:space:]]*V3Kite[[:space:]]*=/ { next }
    in_sources && /^V3Kite[[:space:]]*=/ { print newline; next }
    { print }
' "$PROJECT" > "$TMP"
cp "$TMP" "$PROJECT"

echo "V3Kite -> ${newline#*= }"
julia --project=examples "${JULIA_IMAGE_FLAG[@]}" -e 'using Pkg; Pkg.resolve(); Pkg.instantiate()'
