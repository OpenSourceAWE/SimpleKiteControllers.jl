#!/bin/bash
# Copyright (c) 2025, 2026 Uwe Fechner
# SPDX-License-Identifier: MIT

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

if command -v nproc &> /dev/null; then
    FAST_CORES=$(($(nproc) / 2 - 1))
else
    FAST_CORES=3 # default value
fi

GCT="--gcthreads=4,1"
export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager
export MKL_NUM_THREADS=4

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3} 
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
else
    GCT=""
fi

# Without arguments an interactive session starts with menu() defined, which
# brings up examples/menu.jl. With arguments they are passed to julia unchanged.
julia_init='function menu(); include("examples/menu.jl"); end'

if [[ $# -gt 0 ]]; then
    JULIA_ARGS=("$@")
else
    JULIA_ARGS=(-i -e "$julia_init")
fi

if test -f "bin/kps-image-${julia_major}.so"; then
    echo "Found system image!"
    PLOT=1 julia -J  bin/kps-image-${julia_major}.so -t auto $GCT --project "${JULIA_ARGS[@]}"
else
    PLOT=1 julia --project -t auto  $GCT "${JULIA_ARGS[@]}"
fi
