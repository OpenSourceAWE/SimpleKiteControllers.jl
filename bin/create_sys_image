#!/bin/bash
# Copyright (c) 2026 Uwe Fechner
# SPDX-License-Identifier: MIT

# Creates a PackageCompiler system image with MakieControlPlots and most of
# V3Kite's own dependency chain precompiled for the example scripts;
# bin/run_julia picks it up automatically. It speeds up package load time, not
# init(). examples/create_sys_image.jl also bakes in ModelingToolkit and
# SymbolicAWEModels everywhere except Windows, where the full image is too
# large. Neither RobustKiteControllers nor V3Kite goes into the image, so Revise
# keeps applying to both sources; V3Kite is left to Pkg's ordinary
# precompilation, which this script warms up below. The memory and thread rules
# the build should follow are in docs/sysimage.md.
#
# PackageCompiler is not a dependency of examples/ or the root project: it is
# installed into a throwaway environment that is stacked onto examples/'s via
# JULIA_LOAD_PATH for the duration of this script and removed afterwards.

set -eu

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

# Memory checks and image threads, as specified in docs/sysimage.md; runs first so a small machine fails fast.
if [[ "$OSTYPE" == linux* ]]; then
    _total_mb=$(awk '/^(MemTotal|SwapTotal):/ {s += $2} END {printf "%i", s / 1024}' /proc/meminfo)
    if [[ $_total_mb -lt 30720 ]]; then
        echo "Error: At least 30 GB of RAM + swap is needed to create a system image, but only $(( _total_mb / 1024 )) GB is available." >&2
        echo "Increase your swap file and retry." >&2
        exit 1
    fi
fi

totalmem=""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    echo "Checking system memory on Windows..."
    totalmem=$(powershell.exe -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1MB" 2>/dev/null | awk '{printf "%i", $1}')
    limit_27gb=27000
    min_ram_mb=15000 min_ram_gb=15
elif [[ "$OSTYPE" == darwin* ]]; then
    echo "Checking system memory on macOS..."
    totalmem=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%i", $1 / 1000000}')
    limit_27gb=27000
    min_ram_mb=7000 min_ram_gb=7
else
    totalmem=$(grep MemTotal /proc/meminfo | awk '{printf "%i", $2 / 1024}')
    limit_27gb=26674
    min_ram_mb=15000 min_ram_gb=15
fi

if [[ -z "$totalmem" ]]; then
    echo "Warning: Could not determine the size of the RAM."
elif [[ $totalmem -lt $min_ram_mb ]]; then
    echo "Error: At least $min_ram_gb GB of RAM is needed to create a system image, but only $(( totalmem / 1024 )) GB is available." >&2
    exit 1
fi

# SYSIMAGE_THREADS_AUTO tells examples/create_sys_image.jl that this choice was not the caller's.
if [[ -n "${JULIA_IMAGE_THREADS:-}" ]]; then
    echo "JULIA_IMAGE_THREADS already set to $JULIA_IMAGE_THREADS, leaving as is"
elif [[ -z "$totalmem" ]]; then
    export JULIA_IMAGE_THREADS=1 SYSIMAGE_THREADS_AUTO=true
    echo "Using only one thread for sysimage compilation."
elif [[ $totalmem -lt $limit_27gb ]]; then
    _cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "${NUMBER_OF_PROCESSORS:-2}")
    if [[ $_cpus -ge 4 ]]; then
        export JULIA_IMAGE_THREADS=2
    else
        export JULIA_IMAGE_THREADS=1
    fi
    export SYSIMAGE_THREADS_AUTO=true
    echo "Less than 27GB of memory detected. Using $JULIA_IMAGE_THREADS thread(s) for sysimage compilation."
fi

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi

TMPENV=$(mktemp -d)
trap 'rm -rf "$TMPENV"' EXIT

echo "--- Installing PackageCompiler into a temporary environment ---"
julia --startup-file=no --project="$TMPENV" -e 'using Pkg; Pkg.add("PackageCompiler")'

echo "--- Instantiating the workspace and examples/ ---"
julia --startup-file=no --project=. -e 'using Pkg; Pkg.instantiate()'
julia --startup-file=no --project=examples -e 'using Pkg; Pkg.instantiate()'

echo "--- Creating system image ---"
JULIA_LOAD_PATH="@:${TMPENV}:@stdlib" julia --startup-file=no --project=examples \
    examples/create_sys_image.jl

SOFILE="bin/kps-image-${julia_major}.so"
if [[ -f "$SOFILE" ]]; then
    mv -f "$SOFILE" "$SOFILE.bak"
fi
mv -f kps-image_tmp.so "$SOFILE"
echo "System image created at $SOFILE"

# V3Kite is intentionally NOT in the image (see examples/create_sys_image.jl);
# this triggers Pkg's ordinary precompilation of it against the new sysimage, so
# its PrecompileTools workload lands in a pkgimage cache keyed to it.
echo "--- Precompiling examples/ with the new system image ---"
julia --startup-file=no --project=examples -J "$SOFILE" -e 'using V3Kite, MakieControlPlots, RobustKiteControllers'

echo "--- Precompiling all projects with the new system image ---"
for project in . test docs examples; do
    julia --startup-file=no --project="$project" -J "$SOFILE" -e 'using Pkg; Pkg.precompile()'
done

# Workaround for https://github.com/kahliburke/Kaimon.jl/issues/104: precompile KaimonGate
# (and ZMQ) here, since compiled later inside KaimonGate's precompile process ZMQ segfaults
# with a custom system image. KaimonGate also loads Profile, which is not in the image.
echo "--- Precompiling KaimonGate and Revise with the new system image ---"
if ! julia --startup-file=no --project="@v${julia_major}" -J "$SOFILE" -e '
if Base.identify_package("KaimonGate") !== nothing
    using Pkg; Pkg.precompile("KaimonGate")
    Base.require(Base.PkgId(Base.UUID("9abbd945-dff8-562f-b5e8-e1ebf5ef1b79"), "Profile"))
end'; then
    echo "Warning: Precompiling KaimonGate failed." >&2
fi

# bin/run_julia loads Revise from the global environment; loading it with Distributed also
# compiles its extension DistributedExt.
if ! julia --startup-file=no --project="@v${julia_major}" -J "$SOFILE" -e '
if Base.identify_package("Revise") !== nothing
    using Pkg; Pkg.precompile("Revise")
    using Distributed, Revise
end'; then
    echo "Warning: Precompiling Revise failed." >&2
fi

echo "Done."
